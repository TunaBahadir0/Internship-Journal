@page
@using InternshipJournal.Localization
@model InternshipJournal.Web.Pages.DailyLogs.CreateModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<InternshipJournalResource> L
@{
    ViewData["Title"] = L["DailyLogs:CreateTitle"].Value;
}

<div class="card">
    <div class="card-body">
        <h3>@L["DailyLogs:CreateTitle"]</h3>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-4">
                    <abp-date-picker asp-for="DailyLog.LogDate" />
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-8">
                    <abp-input asp-for="DailyLog.Summary" />
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a asp-page="./Index" class="btn btn-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
