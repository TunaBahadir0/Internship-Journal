@page "{id}"
@using InternshipJournal.Enums
@using InternshipJournal.Localization
@model InternshipJournal.Web.Pages.DailyLogs.DetailModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<InternshipJournalResource> L
@{
    ViewData["Title"] = L["DailyLogs:DetailTitle"].Value;
}

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">@Model.DailyLog.LogDate.ToString("dd.MM.yyyy")</h3>
            <span class="badge bg-info">@L["Enum:DailyLogStatus:" + Model.DailyLog.Status]</span>
        </div>

        <dl class="row">
            <dt class="col-sm-2">@L["DailyLogs:TotalMinutes"]</dt>
            <dd class="col-sm-10">@Model.DailyLog.TotalMinutes</dd>

            @if (Model.DailyLog.SubmittedAt.HasValue)
            {
                <dt class="col-sm-2">@L["DailyLogs:SubmittedAt"]</dt>
                <dd class="col-sm-10">@Model.DailyLog.SubmittedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>
            }
            @if (Model.DailyLog.ReviewedAt.HasValue)
            {
                <dt class="col-sm-2">@L["DailyLogs:ReviewedAt"]</dt>
                <dd class="col-sm-10">@Model.DailyLog.ReviewedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>
            }
            @if (Model.DailyLog.ApprovedAt.HasValue)
            {
                <dt class="col-sm-2">@L["DailyLogs:ApprovedAt"]</dt>
                <dd class="col-sm-10">@Model.DailyLog.ApprovedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>
            }
        </dl>

        @if (Model.IsEditable)
        {
            <form method="post" asp-page-handler="UpdateSummary">
                <div class="row">
                    <div class="col-md-8">
                        <abp-input asp-for="SummaryInput.Summary" label="@L["DailyLogs:Summary"].Value" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-outline-primary mb-3">@L["Save"]</button>
                    </div>
                </div>
            </form>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">@L["DailyLogs:Summary"]</dt>
                <dd class="col-sm-10">@(string.IsNullOrWhiteSpace(Model.DailyLog.Summary) ? "-" : Model.DailyLog.Summary)</dd>
            </dl>
        }

        <div class="mt-3">
            @if (Model.DailyLog.Status == DailyLogStatus.Draft)
            {
                <form method="post" asp-page-handler="Submit" class="d-inline">
                    <button type="submit" class="btn btn-primary">@L["DailyLogs:Submit"]</button>
                </form>
            }
            @if (Model.DailyLog.Status == DailyLogStatus.Submitted)
            {
                <div class="border rounded p-3 mt-2">
                    <p class="text-muted mb-2">@L["DailyLogs:MentorReviewNote"]</p>
                    <form method="post" asp-page-handler="Approve" class="mb-3">
                        <abp-input asp-for="ApproveInput.Comment" label="@L["DailyLogs:ApproveComment"].Value" />
                        <button type="submit" class="btn btn-success mt-2">@L["DailyLogs:Approve"]</button>
                    </form>
                    <form method="post" asp-page-handler="RequestRevision">
                        <abp-input asp-for="RevisionInput.Comment" label="@L["DailyLogs:RevisionComment"].Value" />
                        <button type="submit" class="btn btn-outline-warning mt-2">@L["DailyLogs:RequestRevision"]</button>
                    </form>
                </div>
            }
            @if (Model.DailyLog.Status == DailyLogStatus.RevisionRequested)
            {
                <form method="post" asp-page-handler="ReturnToDraft" class="d-inline">
                    <button type="submit" class="btn btn-outline-secondary">@L["DailyLogs:ReturnToDraft"]</button>
                </form>
            }
        </div>

        <a asp-page="./Index" class="btn btn-link mt-2">@L["BackToList"]</a>
    </div>
</div>

@if (Model.Reviews.Any())
{
    <div class="card mb-3">
        <div class="card-body">
            <h4>@L["MentorReviews:Title"]</h4>
            <ul class="list-group">
                @foreach (var review in Model.Reviews)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold">@L["Enum:MentorReviewDecision:" + review.Decision]</span>
                            <span class="text-muted">@review.ReviewedAt.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                        {
                            <p class="mb-0 mt-1">@review.Comment</p>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <h4>@L["DailyLogs:Items"]</h4>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>@L["DailyLogs:ItemTitle"]</th>
                    <th>@L["DailyLogs:WorkType"]</th>
                    <th>@L["DailyLogs:DurationMinutes"]</th>
                    <th>@L["DailyLogs:IsCompleted"]</th>
                    @if (Model.IsEditable)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.DailyLog.Items)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@L["Enum:WorkType:" + item.WorkType]</td>
                        <td>@item.DurationMinutes</td>
                        <td>@(item.IsCompleted ? L["DailyLogs:Yes"] : L["DailyLogs:No"])</td>
                        @if (Model.IsEditable)
                        {
                            <td class="text-end">
                                <form method="post" asp-page-handler="RemoveItem" asp-route-itemId="@item.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L["DailyLogs:Remove"]</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.IsEditable)
        {
            <form method="post" asp-page-handler="AddItem" class="row g-2 align-items-end mt-2">
                <div class="col-md-4">
                    <abp-input asp-for="NewItem.Title" label="@L["DailyLogs:ItemTitle"].Value" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["DailyLogs:WorkType"]</label>
                    <select asp-for="NewItem.WorkType" asp-items="Model.WorkTypeOptions" class="form-select"></select>
                </div>
                <div class="col-md-2">
                    <abp-input asp-for="NewItem.DurationMinutes" label="@L["DailyLogs:DurationMinutes"].Value" />
                </div>
                <div class="col-md-2 form-check mb-3">
                    <input asp-for="NewItem.IsCompleted" class="form-check-input" />
                    <label class="form-check-label" asp-for="NewItem.IsCompleted">@L["DailyLogs:IsCompleted"]</label>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-outline-primary mb-3">@L["DailyLogs:Add"]</button>
                </div>
            </form>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h4>@L["DailyLogs:Skills"]</h4>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>@L["DailyLogs:Skill"]</th>
                    <th>@L["DailyLogs:LearningLevel"]</th>
                    <th>@L["DailyLogs:Note"]</th>
                    @if (Model.IsEditable)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var skill in Model.DailyLog.Skills)
                {
                    <tr>
                        <td>@Model.SkillName(skill.SkillId)</td>
                        <td>@L["Enum:LearningLevel:" + skill.LearningLevel]</td>
                        <td>@(string.IsNullOrWhiteSpace(skill.Note) ? "-" : skill.Note)</td>
                        @if (Model.IsEditable)
                        {
                            <td class="text-end">
                                <form method="post" asp-page-handler="RemoveSkill" asp-route-skillEntryId="@skill.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L["DailyLogs:Remove"]</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.IsEditable)
        {
            <form method="post" asp-page-handler="AddSkill" class="row g-2 align-items-end mt-2">
                <div class="col-md-4">
                    <label class="form-label">@L["DailyLogs:Skill"]</label>
                    <select asp-for="NewSkill.SkillId" asp-items="Model.SkillOptions" class="form-select">
                        <option value="">@L["DailyLogs:SelectSkill"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["DailyLogs:LearningLevel"]</label>
                    <select asp-for="NewSkill.LearningLevel" asp-items="Model.LearningLevelOptions" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="NewSkill.Note" label="@L["DailyLogs:Note"].Value" />
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-outline-primary mb-3">@L["DailyLogs:Add"]</button>
                </div>
            </form>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h4>@L["DailyLogs:Problems"]</h4>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>@L["DailyLogs:ItemTitle"]</th>
                    <th>@L["DailyLogs:ProblemDescription"]</th>
                    <th>@L["DailyLogs:UsedArtificialIntelligence"]</th>
                    @if (Model.IsEditable)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var problem in Model.DailyLog.Problems)
                {
                    <tr>
                        <td>@problem.Title</td>
                        <td>@problem.ProblemDescription</td>
                        <td>@(problem.UsedArtificialIntelligence ? L["DailyLogs:Yes"] : L["DailyLogs:No"])</td>
                        @if (Model.IsEditable)
                        {
                            <td class="text-end">
                                <form method="post" asp-page-handler="RemoveProblem" asp-route-problemId="@problem.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L["DailyLogs:Remove"]</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.IsEditable)
        {
            <form method="post" asp-page-handler="AddProblem" class="row g-2 mt-2">
                <div class="col-md-6">
                    <abp-input asp-for="NewProblem.Title" label="@L["DailyLogs:ItemTitle"].Value" />
                </div>
                <div class="col-md-6">
                    <abp-input asp-for="NewProblem.ProblemDescription" label="@L["DailyLogs:ProblemDescription"].Value" />
                </div>
                <div class="col-md-4 form-check mb-3">
                    <input asp-for="NewProblem.UsedArtificialIntelligence" class="form-check-input" />
                    <label class="form-check-label" asp-for="NewProblem.UsedArtificialIntelligence">@L["DailyLogs:UsedArtificialIntelligence"]</label>
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="NewProblem.AiToolName" label="@L["DailyLogs:AiToolName"].Value" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="NewProblem.AiPromptSummary" label="@L["DailyLogs:AiPromptSummary"].Value" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary">@L["DailyLogs:Add"]</button>
                </div>
            </form>
        }
    </div>
</div>
