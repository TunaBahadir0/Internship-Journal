@page
@using InternshipJournal.Localization
@model InternshipJournal.Web.Pages.Profile.EditModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<InternshipJournalResource> L
@{
    ViewData["Title"] = L["Profile:EditTitle"].Value;
}

<div class="card">
    <div class="card-body">
        <h3>@L["Profile:EditTitle"]</h3>
        <p class="text-muted">@L["Profile:EditNote"]</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="InternProfile.MentorUserId" />
            <input type="hidden" asp-for="InternProfile.WorkplaceId" />
            <input type="hidden" asp-for="InternProfile.InternshipStartDate" />
            <input type="hidden" asp-for="InternProfile.InternshipEndDate" />
            <input type="hidden" asp-for="InternProfile.RequiredWorkDays" />

            <div class="row">
                <div class="col-md-4">
                    <abp-input asp-for="InternProfile.University" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="InternProfile.SchoolDepartment" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="InternProfile.StudentNumber" />
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a asp-page="./Index" class="btn btn-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
