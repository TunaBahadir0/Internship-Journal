@page
@model InternshipJournal.Web.Pages.Profile.EditModel
@{
    ViewData["Title"] = "Profilimi Düzenle";
}

<div class="card">
    <div class="card-body">
        <h3>Profilimi Düzenle</h3>
        <p class="text-muted">Yalnızca eğitim bilgilerinizi güncelleyebilirsiniz. Çalışma yeri, mentor ve staj tarihleri yöneticiniz tarafından değiştirilir.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="InternProfile.MentorUserId" />
            <input type="hidden" asp-for="InternProfile.WorkplaceId" />
            <input type="hidden" asp-for="InternProfile.InternshipStartDate" />
            <input type="hidden" asp-for="InternProfile.InternshipEndDate" />
            <input type="hidden" asp-for="InternProfile.RequiredWorkDays" />

            <div class="row">
                <div class="col-md-4">
                    <abp-input asp-for="InternProfile.University" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="InternProfile.SchoolDepartment" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="InternProfile.StudentNumber" />
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-page="./Index" class="btn btn-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>
