@page
@using InternshipJournal.Localization
@model InternshipJournal.Web.Pages.Profile.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<InternshipJournalResource> L
@{
    ViewData["Title"] = L["Profile:Title"].Value;
}

<div class="card">
    <div class="card-body">
        @if (Model.InternProfile == null)
        {
            <h3>@L["Profile:Title"]</h3>
            <p class="text-muted">@L["Profile:NoProfile"]</p>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">@Model.InternProfile.FullName</h3>
                <span class="badge bg-info">@L["Enum:InternshipStatus:" + Model.InternProfile.Status]</span>
            </div>

            <dl class="row">
                <dt class="col-sm-3">@L["InternProfiles:UserName"]</dt>
                <dd class="col-sm-9">@Model.InternProfile.UserName</dd>

                <dt class="col-sm-3">@L["Email"]</dt>
                <dd class="col-sm-9">@(Model.InternProfile.Email ?? "-")</dd>

                <dt class="col-sm-3">@L["University"]</dt>
                <dd class="col-sm-9">@Model.InternProfile.University</dd>

                <dt class="col-sm-3">@L["SchoolDepartment"]</dt>
                <dd class="col-sm-9">@Model.InternProfile.SchoolDepartment</dd>

                <dt class="col-sm-3">@L["StudentNumber"]</dt>
                <dd class="col-sm-9">@Model.InternProfile.StudentNumber</dd>

                <dt class="col-sm-3">@L["InternProfiles:Workplace"]</dt>
                <dd class="col-sm-9">@Model.InternProfile.WorkplaceName</dd>

                <dt class="col-sm-3">@L["InternProfiles:Address"]</dt>
                <dd class="col-sm-9">@Model.InternProfile.AddressLine, @Model.InternProfile.DistrictName / @Model.InternProfile.ProvinceName / @Model.InternProfile.CountryName</dd>

                <dt class="col-sm-3">@L["InternProfiles:Mentor"]</dt>
                <dd class="col-sm-9">@Model.InternProfile.MentorFullName</dd>

                <dt class="col-sm-3">@L["InternProfiles:Period"]</dt>
                <dd class="col-sm-9">@Model.InternProfile.InternshipStartDate.ToString("dd.MM.yyyy") - @Model.InternProfile.InternshipEndDate.ToString("dd.MM.yyyy")</dd>

                <dt class="col-sm-3">@L["RequiredWorkDays"]</dt>
                <dd class="col-sm-9">@Model.InternProfile.RequiredWorkDays</dd>
            </dl>

            <a asp-page="./Edit" class="btn btn-primary">@L["Edit"]</a>
        }
    </div>
</div>
