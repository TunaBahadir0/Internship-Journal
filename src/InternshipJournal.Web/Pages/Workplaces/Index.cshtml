@page
@model InternshipJournal.Web.Pages.Workplaces.IndexModel
@{
    ViewData["Title"] = "Çalışma Yerleri";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Çalışma Yerleri</h3>
            <a asp-page="./Create" class="btn btn-primary">Yeni Çalışma Yeri</a>
        </div>

        <form method="get" class="row mb-3">
            <div class="col-md-4">
                <input type="text" name="Filter" value="@Model.Filter" class="form-control" placeholder="Ada göre ara..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary">Ara</button>
            </div>
        </form>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>İlçe</th>
                    <th>İl</th>
                    <th>Ülke</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var workplace in Model.Workplaces)
                {
                    <tr>
                        <td>@workplace.Name</td>
                        <td>@workplace.DistrictName</td>
                        <td>@workplace.ProvinceName</td>
                        <td>@workplace.CountryName</td>
                        <td>
                            @if (workplace.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-page="./Detail" asp-route-id="@workplace.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                            <a asp-page="./Edit" asp-route-id="@workplace.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            @if (workplace.IsActive)
                            {
                                <form method="post" asp-page-handler="Deactivate" asp-route-id="@workplace.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Pasifleştir</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Activate" asp-route-id="@workplace.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Aktifleştir</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
