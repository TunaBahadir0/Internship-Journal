@page
@using InternshipJournal.Localization
@model InternshipJournal.Web.Pages.Workplaces.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<InternshipJournalResource> L
@{
    ViewData["Title"] = L["Workplaces:Title"].Value;
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">@L["Workplaces:Title"]</h3>
            <a asp-page="./Create" class="btn btn-primary">@L["Workplaces:New"]</a>
        </div>

        <form method="get" class="row mb-3">
            <div class="col-md-4">
                <input type="text" name="Filter" value="@Model.Filter" class="form-control" placeholder="@L["Workplaces:SearchPlaceholder"]" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary">@L["Search"]</button>
            </div>
        </form>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>@L["Name"]</th>
                    <th>@L["Workplaces:District"]</th>
                    <th>@L["Workplaces:Province"]</th>
                    <th>@L["Workplaces:Country"]</th>
                    <th>@L["Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var workplace in Model.Workplaces)
                {
                    <tr>
                        <td>@workplace.Name</td>
                        <td>@workplace.DistrictName</td>
                        <td>@workplace.ProvinceName</td>
                        <td>@workplace.CountryName</td>
                        <td>
                            @if (workplace.IsActive)
                            {
                                <span class="badge bg-success">@L["Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@L["Inactive"]</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-page="./Detail" asp-route-id="@workplace.Id" class="btn btn-sm btn-outline-secondary">@L["Detail"]</a>
                            <a asp-page="./Edit" asp-route-id="@workplace.Id" class="btn btn-sm btn-outline-primary">@L["Edit"]</a>
                            @if (workplace.IsActive)
                            {
                                <form method="post" asp-page-handler="Deactivate" asp-route-id="@workplace.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L["Workplaces:Deactivate"]</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Activate" asp-route-id="@workplace.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">@L["Workplaces:Activate"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
