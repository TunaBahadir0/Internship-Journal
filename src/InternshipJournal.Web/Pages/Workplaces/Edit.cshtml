@page "{id}"
@using InternshipJournal.Localization
@model InternshipJournal.Web.Pages.Workplaces.EditModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<InternshipJournalResource> L
@{
    ViewData["Title"] = L["Workplaces:EditTitle"].Value;
}

<div class="card">
    <div class="card-body">
        <h3>@L["Workplaces:EditTitle"]</h3>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <abp-input asp-for="Workplace.Name" />
                </div>
                <div class="col-md-6">
                    <abp-input asp-for="Workplace.TaxNumber" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <abp-input asp-for="Workplace.Phone" />
                </div>
                <div class="col-md-6">
                    <abp-input asp-for="Workplace.Email" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <abp-input asp-for="Workplace.Website" />
                </div>
            </div>

            <hr />
            <h5>@L["Workplaces:AddressSection"]</h5>

            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">@L["Workplaces:Country"]</label>
                    <select id="CountrySelect" class="form-select">
                        <option value="">@L["Workplaces:SelectCountry"]</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Workplaces:Province"]</label>
                    <select id="ProvinceSelect" class="form-select" disabled>
                        <option value="">@L["Workplaces:SelectProvince"]</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Workplaces:District"]</label>
                    <select asp-for="Workplace.DistrictId" id="DistrictSelect" class="form-select" disabled>
                        <option value="">@L["Workplaces:SelectDistrict"]</option>
                    </select>
                    <span asp-validation-for="Workplace.DistrictId" class="text-danger"></span>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-8">
                    <abp-input asp-for="Workplace.AddressLine" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="Workplace.PostalCode" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <abp-input asp-for="Workplace.Latitude" />
                </div>
                <div class="col-md-6">
                    <abp-input asp-for="Workplace.Longitude" />
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a asp-page="./Index" class="btn btn-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script src="~/js/workplace-location-selector.js"></script>
    <script>
        $(function () {
            workplaceLocationSelector.create({
                countrySelect: '#CountrySelect',
                provinceSelect: '#ProvinceSelect',
                districtSelect: '#DistrictSelect',
                countryPlaceholder: '@L["Workplaces:SelectCountry"]',
                provincePlaceholder: '@L["Workplaces:SelectProvince"]',
                districtPlaceholder: '@L["Workplaces:SelectDistrict"]',
                errorMessage: '@L["Workplaces:LocationLoadError"]',
                selectedCountryId: '@Model.SelectedCountryId',
                selectedProvinceId: '@Model.SelectedProvinceId',
                selectedDistrictId: '@Model.Workplace.DistrictId'
            });
        });
    </script>
}
