@page
@using InternshipJournal.Enums
@model InternshipJournal.Web.Pages.InternProfiles.IndexModel
@{
    ViewData["Title"] = "Staj Profilleri";
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Staj Profilleri</h3>
            <a asp-page="./Create" class="btn btn-primary">Yeni Staj Profili</a>
        </div>

        <form method="get" class="row mb-3">
            <div class="col-md-4">
                <input type="text" name="Filter" value="@Model.Filter" class="form-control" placeholder="Kullanıcı adına göre ara..." />
            </div>
            <div class="col-md-3">
                <select name="Status" class="form-select" asp-items="Html.GetEnumSelectList<InternshipStatus>()" asp-for="Status">
                    <option value="">Tüm durumlar</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary">Ara</button>
            </div>
        </form>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Kullanıcı</th>
                    <th>Ad Soyad</th>
                    <th>Çalışma Yeri</th>
                    <th>Staj Dönemi</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var profile in Model.InternProfiles)
                {
                    <tr>
                        <td>@profile.UserName</td>
                        <td>@profile.FullName</td>
                        <td>@profile.WorkplaceName</td>
                        <td>@profile.InternshipStartDate.ToString("dd.MM.yyyy") - @profile.InternshipEndDate.ToString("dd.MM.yyyy")</td>
                        <td>@profile.Status</td>
                        <td class="text-end">
                            <a asp-page="./Detail" asp-route-id="@profile.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                            <a asp-page="./Edit" asp-route-id="@profile.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            @if (profile.Status == InternshipStatus.Draft)
                            {
                                <form method="post" asp-page-handler="Start" asp-route-id="@profile.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Başlat</button>
                                </form>
                            }
                            @if (profile.Status == InternshipStatus.Active)
                            {
                                <form method="post" asp-page-handler="Complete" asp-route-id="@profile.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Tamamla</button>
                                </form>
                            }
                            @if (profile.Status is InternshipStatus.Draft or InternshipStatus.Active)
                            {
                                <form method="post" asp-page-handler="Cancel" asp-route-id="@profile.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">İptal Et</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
