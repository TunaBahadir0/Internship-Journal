@page
@using InternshipJournal.Localization
@model InternshipJournal.Web.Pages.InternProfiles.CreateModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<InternshipJournalResource> L
@{
    ViewData["Title"] = L["InternProfiles:CreateTitle"].Value;
}

<div class="card">
    <div class="card-body">
        <h3>@L["InternProfiles:CreateTitle"]</h3>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">@L["InternProfiles:Intern"]</label>
                    <select asp-for="InternProfile.UserId" asp-items="Model.Users" class="form-select">
                        <option value="">@L["InternProfiles:SelectIntern"]</option>
                    </select>
                    <span asp-validation-for="InternProfile.UserId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@L["InternProfiles:Mentor"]</label>
                    <select asp-for="InternProfile.MentorUserId" asp-items="Model.Users" class="form-select">
                        <option value="">@L["InternProfiles:SelectMentor"]</option>
                    </select>
                    <span asp-validation-for="InternProfile.MentorUserId" class="text-danger"></span>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-12">
                    <label class="form-label">@L["InternProfiles:Workplace"]</label>
                    <select asp-for="InternProfile.WorkplaceId" asp-items="Model.Workplaces" class="form-select">
                        <option value="">@L["InternProfiles:SelectWorkplace"]</option>
                    </select>
                    <span asp-validation-for="InternProfile.WorkplaceId" class="text-danger"></span>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-4">
                    <abp-input asp-for="InternProfile.University" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="InternProfile.SchoolDepartment" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="InternProfile.StudentNumber" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <abp-input asp-for="InternProfile.InternshipStartDate" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="InternProfile.InternshipEndDate" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="InternProfile.RequiredWorkDays" />
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a asp-page="./Index" class="btn btn-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
