@page
@using InternshipJournal.Localization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<InternshipJournalResource> L
<div class="row mb-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h3>@L["Welcome"]</h3>
                <p class="lead text-muted mb-2">@L["LongWelcomeMessage"]</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4 d-flex mb-3">
        <div class="card w-100">
            <div class="card-body">
                <h4>@L["Home:GettingStarted"]</h4>
                <p class="text-muted">@L["Home:GettingStartedText"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 d-flex mb-3">
        <div class="card w-100">
            <div class="card-body">
                <h4>@L["Home:Workplaces"]</h4>
                <p class="text-muted">@L["Home:WorkplacesText"]</p>
                <a asp-page="/Workplaces/Index" class="btn btn-primary soft">@L["Menu:Workplaces"]</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 d-flex mb-3">
        <div class="card w-100">
            <div class="card-body">
                <h4>@L["Home:InternProfiles"]</h4>
                <p class="text-muted">@L["Home:InternProfilesText"]</p>
                <a asp-page="/InternProfiles/Index" class="btn btn-primary soft">@L["Menu:InternProfiles"]</a>
            </div>
        </div>
    </div>
</div>
